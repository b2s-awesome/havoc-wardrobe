	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/havoc_wardrobe/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.havoc.wardrobe.HavocWardrobe"]
	},
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"economycraft": ">=1.11.0"
	}
